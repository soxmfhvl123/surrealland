# Copy to .env.local and fill in, then restart `npm run dev`.
# Create a key at https://open.higgsfield.ai/api-keys and paste it as-is.
# The key stays on this machine: only the local dev server reads it.
HF_API_KEY=paste-your-key-here

# Google Nano Banana (Gemini image models): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
